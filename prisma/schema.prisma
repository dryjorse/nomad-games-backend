generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  username        String   @unique
  createdAt       DateTime @default(now())
  gamesAsFirst    Game[]   @relation("FirstPlayer")
  gamesAsSecond   Game[]   @relation("SecondPlayer")
  queue           Queue?
}

model Queue {
  id        String   @id @default(uuid())
  userId    String   @unique  
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Game {
  id                String     @id @default(ulid())
  status            GameStatus @default(WAITING)
  firstPlayerId     String 
  firstPlayer       User       @relation("FirstPlayer", fields: [firstPlayerId], references: [id])
  secondPlayerId    String? 
  secondPlayer      User?      @relation("SecondPlayer", fields: [secondPlayerId], references: [id])
  board             Int[]      @default([9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9])
  firstAce          Int?
  secondAce         Int?
  firstPlayerRole   GameRole   @default(WHITE)
  currentTurn       GameRole   @default(WHITE)
  firstPlayerScore  Int        @default(0)
  secondPlayerScore Int        @default(0)
  winnerId          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

enum GameStatus {
  WAITING
  ACTIVE
  FINISHED
}

enum GameRole {
  BLACK
  WHITE
}